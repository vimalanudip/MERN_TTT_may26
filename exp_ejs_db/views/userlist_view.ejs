<html>
    <body>
         
        <table align="center">
            <tr>
               <th>Userid</th>
               <th>First Name</th>
               <th>Last name</th>
               <th>Date of birth</th>
               <th>Gender</th>
            </tr>
            <% for(let i=0;i<data.length;i++) {
                
                %><tr>
                    <td><%=data[i].id%></td>
                    <td><%=data[i].fname%></td>
                    <td><%=data[i].lname%></td>
                    <td><%=data[i].dob%></td>
                    <td><%=data[i].gender%></td>
                </tr>
                <% } %>
        </table>
        </body>
        </html>